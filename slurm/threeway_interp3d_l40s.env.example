# Copy this file, set the TWO checkpoint paths, then source it with set -a.
# Paths below are HOST paths on Ateneo HPC, not Leonardo paths.
CHECKPOINT_PATH="/hpc/archive/G_VBD/marco.barezzi/REPLACE_SS/checkpoints/morphflow_best.pt"
SLAT_CHECKPOINT_PATH="/hpc/archive/G_VBD/marco.barezzi/REPLACE_SLAT/checkpoints/morphflow_best.pt"

# A new RUN_NAME selects new checkpoints/configuration. Reuse it to resume.
RUN_NAME="v4_selected_checkpoints_interp3d_fulltest"
DATASET_NAME="morphing_dataset_v4"
METADATA="metadata_test.json"
N=0                         # ALL unique ordered test pairs; current v4 has 500.
CFG_VALUES="2 3 5"           # Cartesian product with SLAT_CFG_VALUES.
SLAT_CFG_VALUES="1.5 2 2.5"
WEIGHTED_DENSE=1            # ALSO run weighted LPIPS on 50 frames: 48 uniform intermediates + 2 sources.
EXPORT_GLB=0                # Save mesh/Gaussian raw assets; bake GLBs later if needed (1 exports all now).
SEED=42
MIXED_PRECISION=bf16

# Optional overrides; defaults come from the working v3/Ateneo launchers.
# PROJECT_DIR="$HOME/trellis-singularity/work/MorphFlow"
# SIF="$HOME/containers/trellis-py240-cu118.sif"
# BENCH_ROOT="/hpc/scratch/marco.barezzi/morph-benchmark"
# BENCH_ARCHIVE="/hpc/archive/G_VBD/marco.barezzi/morph-benchmark"
# DATA_PARENT="/hpc/scratch/marco.barezzi/3d_dataset"
# RUN_ROOT="$BENCH_ROOT/threeway-runs/$RUN_NAME"
# PROTOCOL_PYTHON="$BENCH_ROOT/protocol-python"
# GAUSSIAN_CUDA_ARCH_LIST=8.9   # L40S; explicit target allows compilation without a login GPU.
# GAUSSIAN_BUILD_JOBS=2        # Used by prepare_threeway_interp3d_l40s.sh --prepare.
# NODE_LOCAL_PARENT="/nvme/$USER/morph-benchmark"
# MORPHANY_TFSA_RAM_GB_PER_WORKER=12
# MORPHANY_TFSA_MIN_NODE_FREE_GB=32
# LPIPS_BATCH_SIZE=4
# FID_BATCH_SIZE=8
# TEXTURE_SIZE=1024
# SIMPLIFY=0.95
# FILL_HOLES=1
